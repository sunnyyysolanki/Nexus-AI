# ==========================================
# NEXUS AI — Master Deployment Environment Config (Template)
# ==========================================

# Database Connections
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# Individual Service Database URLs
ALERT_DB_URL=jdbc:postgresql://localhost:5432/nexus_alert_db
INCIDENT_DB_URL=jdbc:postgresql://localhost:5432/nexus_incident_db
LOG_DB_URL=jdbc:postgresql://localhost:5432/nexus_log_db
METRIC_DB_URL=jdbc:postgresql://localhost:5432/nexus_metric_db
RCA_DB_URL=jdbc:postgresql://localhost:5433/nexus_rca_db

# Kafka Event Streaming
KAFKA_SERVERS=localhost:9092

# Service Ports
API_GATEWAY_PORT=8080
LOG_SERVICE_PORT=8081
METRIC_SERVICE_PORT=8082
ALERT_SERVICE_PORT=8083
INCIDENT_SERVICE_PORT=8084
RCA_SERVICE_PORT=8085

# Microservice URLs (Used by API Gateway)
ALERT_SERVICE_URL=http://localhost:8083
INCIDENT_SERVICE_URL=http://localhost:8084
LOG_SERVICE_URL=http://localhost:8081
METRIC_SERVICE_URL=http://localhost:8082
RCA_SERVICE_URL=http://localhost:8085

# AI Provider Configuration (Ollama / OpenAI)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=minicpm-v4.6
AI_EMBEDDING_MODEL=nomic-embed-text
